{
  "name": "loom",
  "version": "0.0.0",
  "description": "Loom — 个人 agent 思考工作台（Electron + React + pi-mono）",
  "main": "./out/main/index.js",
  "build": {
    "appId": "com.neoland.loom",
    "productName": "Loom",
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "icon": "build/icon.icns",
      "sign": "scripts/mac-sign.cjs"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png"
    }
  },
  "scripts": {
    "prepare:electron": "install-electron --no",
    "predev": "pnpm run prepare:electron",
    "dev": "ELECTRON_RUN_AS_NODE= electron-vite dev",
    "build": "electron-vite build",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "postinstall": "electron-rebuild -f -v 43.2.0 -w better-sqlite3",
    "prestart": "pnpm run prepare:electron",
    "start": "ELECTRON_RUN_AS_NODE= electron-vite preview",
    "test": "ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.2.1",
    "@earendil-works/pi-agent-core": "^0.82.0",
    "@earendil-works/pi-ai": "^0.82.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "lucide-react": "^1.24.0",
    "monaco-editor": "^0.56.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "^1.3.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
